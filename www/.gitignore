# Ignore directories and files generated by Composer
/vendor/
/backups/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/
/.editorconfig
/.gitattributes

# Ignore local settings
/web/sites/*/services.local.yml
/web/sites/*/settings.local.php
/web/sites/*/settings.client.php

# Ignore Drupal's file directory
/web/sites/*/files/
/private
/tmp

# Ignore files generated by PhpStorm and Visual Studio Code
/.idea/
/.vscode/
/.junie
/.claude

# Ignore DB dumps
*.sql
*.sql.gz
